/* ============ ORB ============ */
let orbState = "idle"; // idle, listening, thinking, speaking
function startOrbAnim(){
  const svg = document.getElementById("orbCanvasSvg");
  let t = 0;
  function frame(){
    t += 0.03;
    let r1=70, r2=55, r3=40, opacity=0.9;
    if(orbState==="listening"){ r1 = 70 + Math.sin(t*3)*8; r2 = 55 + Math.sin(t*3+1)*6; }
    else if(orbState==="thinking"){ r1 = 70 + Math.sin(t*8)*10; r3 = 40 + Math.sin(t*8)*6; }
    else if(orbState==="speaking"){ r1 = 70 + Math.sin(t*5)*5; r2 = 55 + Math.sin(t*5+0.6)*8; r3 = 40 + Math.sin(t*5+1.2)*5; }
    else { r1 = 70 + Math.sin(t)*3; }
    svg.innerHTML =
      '<defs><radialGradient id="orbGrad" cx="50%" cy="50%" r="50%">'+
      '<stop offset="0%" stop-color="'+CONFIG.themeColor+'" stop-opacity="0.9"/>'+
      '<stop offset="100%" stop-color="'+CONFIG.themeColor+'" stop-opacity="0"/>'+
      '</radialGradient></defs>'+
      '<circle cx="110" cy="110" r="'+r1+'" fill="url(#orbGrad)" opacity="0.5"/>'+
      '<circle cx="110" cy="110" r="'+r2+'" fill="none" stroke="'+CONFIG.themeColor+'" stroke-width="1.5" opacity="0.6"/>'+
      '<circle cx="110" cy="110" r="'+r3+'" fill="'+CONFIG.themeColor+'" opacity="'+opacity+'"/>';
    requestAnimationFrame(frame);
  }
  frame();
}
