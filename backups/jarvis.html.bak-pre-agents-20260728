  html += `<div class="emailBucket"><h3>INFO (${buckets.info.length})</h3>${renderEmailRows_(buckets.info)}</div>`;
  html += `<details class="ruidoBox"><summary>RUÍDO (${buckets.ruido.length})</summary>${renderEmailRows_(buckets.ruido)}</details>`;
  el.innerHTML = html;
  el.querySelectorAll(".emailRow").forEach(row => row.addEventListener("click", () => row.classList.toggle("open")));
}
