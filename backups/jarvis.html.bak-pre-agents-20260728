    background: radial-gradient(circle at 35% 30%, var(--primary,#22c3ff), var(--accent,#8b5cf6) 70%, transparent 100%);
    box-shadow: 0 0 50px 6px rgba(34,195,255,.45);
    animation: faceBreathe 4.5s ease-in-out infinite;
  }
  @keyframes faceBreathe{ 0%,100%{ opacity:.75; transform: scale(.94); } 50%{ opacity:1; transform: scale(1.05); } }

  #faceMode[data-s="listening"] .ring.r1{ animation-duration: 4s; }
  #faceMode[data-s="listening"] .face-core{ box-shadow: 0 0 66px 10px rgba(34,195,255,.6); }
  #faceMode[data-s="thinking"] .ring.r1{ animation-duration: 2s; }
  #faceMode[data-s="thinking"] .ring.r2{ animation-duration: 4s; }
  #faceMode[data-s="thinking"] .face-core{ animation-duration: 1.4s; }
  #faceMode[data-s="speaking"] .ring.r3{ animation-duration: 6s; }
  #faceMode[data-s="speaking"] .face-core{ box-shadow: 0 0 60px 12px rgba(139,92,246,.55); }

  .face-state{
    position:relative; z-index:2; text-align:center; margin-top: calc(min(46vh,340px) + 34px);
    font-size:.82rem; letter-spacing:.4em; font-weight:600; color: var(--primary,#22c3ff);
    text-shadow: 0 0 16px rgba(34,195,255,.5);
  }
  .face-legend{
    position:relative; z-index:2; text-align:center; margin: 10px auto 0; max-width: 60ch; padding: 0 20px;
    font-size:.95rem; color: var(--txt2,#aab6cc); min-height: 1.4em;
  }

  .face-hud{ position:absolute; top: 130px; bottom: 96px; width: min(240px,22vw); z-index:2; display:flex; flex-direction:column; gap:14px; overflow:hidden; }
  .face-hud-left{ left: 28px; }
  .face-hud-right{ right: 28px; }
  .face-panel{
    background: var(--card,rgba(14,20,36,.55)); backdrop-filter: blur(14px);
    border: 1px solid var(--border-strong, rgba(34,195,255,.3)); border-radius: var(--radius-sm,13px);
    padding: 12px 14px; font-size:.72rem;
  }
  .face-panel h5{ font-size:.65rem; letter-spacing:.18em; color: var(--txt3,#6b7690); margin:0 0 8px; text-transform:uppercase; }
  .face-vital-row{ display:flex; align-items:center; gap:8px; margin-bottom:6px; font-variant-numeric:tabular-nums; }
  .face-vital-row span:first-child{ width: 44px; color: var(--txt3,#6b7690); font-size:.62rem; letter-spacing:.06em; }
  .face-vital-bar{ flex:1; height:4px; background: rgba(255,255,255,.08); border-radius:2px; overflow:hidden; }
  .face-vital-bar i{ display:block; height:100%; background: var(--grad,linear-gradient(90deg,#22c3ff,#8b5cf6)); width:0%; transition: width .4s var(--ease,ease); }
  .face-vital-row span:last-child{ width: 38px; text-align:right; color: var(--txt2,#aab6cc); }
  .face-status-row{ display:flex; align-items:center; gap:8px; margin-bottom:6px; }
  .face-dot{ width:7px; height:7px; border-radius:50%; background: var(--txt3,#6b7690); flex-shrink:0; }
  .face-dot.ok{ background: var(--green,#22c55e); box-shadow:0 0 8px rgba(34,197,94,.7); }
  .face-dot.warn{ background: var(--yellow,#fbbf24); box-shadow:0 0 8px rgba(251,191,36,.7); }
  .face-dot.off{ background: var(--txt3,#6b7690); }
  .face-logs{ font-family: var(--font,monospace); font-size:.66rem; line-height:1.6; color: var(--txt3,#6b7690); overflow:hidden; max-height: 160px; }
  .face-logs div{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .face-feed a{ display:block; color: var(--txt2,#aab6cc); text-decoration:none; font-size:.7rem; padding:5px 0; border-bottom:1px solid var(--border,rgba(148,178,220,.1)); }
  .face-feed a:hover{ color: var(--primary,#22c3ff); }

  .face-ticker{
    position:absolute; left:0; right:0; bottom: 44px; z-index:2; text-align:center;
    font-size:.72rem; letter-spacing:.1em; color: var(--txt3,#6b7690); font-variant-numeric: tabular-nums;
  }
  .face-ticker b{ color: var(--txt2,#aab6cc); font-weight:600; margin: 0 4px; }
  .face-hint{ position:absolute; right:20px; bottom:16px; z-index:2; font-size:.62rem; letter-spacing:.1em; color: var(--txt3,#6b7690); opacity:.7; }

  #faceToggleBtn{ font-size:1.05rem; }

  @media (prefers-reduced-motion: reduce){
    .ring, .face-core, #faceMode::after{ animation: none !important; }
  }
  @media (max-width: 780px){
    .face-hud{ display:none; }
    .face-orb-wrap{ width: min(56vw,260px); height: min(56vw,260px); }
    .face-state{ margin-top: calc(min(56vw,260px) + 30px); }
  }
</style>

<div id="faceMode" data-s="idle">
  <div class="face-corner tl"></div><div class="face-corner tr"></div>
  <div class="face-corner bl"></div><div class="face-corner br"></div>
  <div class="face-top">
    <div class="face-brand">JARVIS</div>
    <div class="face-clock"><div class="face-time" id="faceTime">--:--:--</div><div class="face-date" id="faceDate">—</div></div>
  </div>
  <div class="face-orb-wrap">
    <canvas id="faceGlobe"></canvas>
    <div class="face-rings">
      <div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div>
      <div class="face-core"></div>
    </div>
  </div>
  <div class="face-state" id="faceStateLabel">ONLINE</div>
  <div class="face-legend" id="faceLegend">Sistemas prontos.</div>

  <div class="face-hud face-hud-left">
    <div class="face-panel"><h5>Vitals</h5>
      <div class="face-vital-row"><span>FPS</span><div class="face-vital-bar"><i id="fvFps"></i></div><span id="fvFpsN">—</span></div>
      <div class="face-vital-row"><span>Heap</span><div class="face-vital-bar"><i id="fvHeap"></i></div><span id="fvHeapN">—</span></div>
      <div class="face-vital-row"><span>Áudio</span><div class="face-vital-bar"><i id="fvAudio"></i></div><span id="fvAudioN">—</span></div>
      <div class="face-vital-row"><span>Notas</span><div class="face-vital-bar"><i id="fvNotes"></i></div><span id="fvNotesN">—</span></div>
    </div>
    <div class="face-panel"><h5>Status</h5>
      <div class="face-status-row"><span class="face-dot" id="fsAntenna"></span><span>Antena</span></div>
      <div class="face-status-row"><span class="face-dot" id="fsVoz"></span><span>Voz</span></div>
      <div class="face-status-row"><span class="face-dot" id="fsAcao"></span><span id="fsAcaoLabel">E-mails ação</span></div>
    </div>
  </div>

  <div class="face-hud face-hud-right">
    <div class="face-panel"><h5>Logs</h5><div class="face-logs" id="faceLogs"></div></div>
    <div class="face-panel"><h5>Feeds</h5><div class="face-feed" id="faceFeeds"><div style="color:var(--txt3,#6b7690);">aguardando sync…</div></div></div>
  </div>

  <div class="face-ticker" id="faceTicker">AGENDA HOJE <b>—</b> · E-MAILS AÇÃO <b>—</b> · NOTAS <b>—</b></div>
  <div class="face-hint">F sai · clique no orbe pra falar</div>
</div>

<script id="face-script">
(function(){
"use strict";

var faceMode = document.getElementById("faceMode");
document.body.appendChild(faceMode); // reparenta pra garantir que fica na árvore visível

var rafId = null, running = false, intervalIds = [];
var canvas = document.getElementById("faceGlobe"), ctx = canvas ? canvas.getContext("2d") : null;
var points = [];

function buildSphere(n){
  var pts = [];
  var offset = 2 / n, increment = Math.PI * (3 - Math.sqrt(5));
  for(var i = 0; i < n; i++){
    var y = ((i * offset) - 1) + (offset / 2);
    var r = Math.sqrt(Math.max(0, 1 - y*y));
    var phi = (i % n) * increment;
    pts.push({ x: Math.cos(phi) * r, y: y, z: Math.sin(phi) * r });
  }
  return pts;
}
points = buildSphere(760);

function audioLevel(){
  try{
    if(typeof window._jarvisAudioLevel === "function") return Math.max(0, Math.min(1, window._jarvisAudioLevel()));
    if(typeof window._micLevel === "function") return Math.max(0, Math.min(1, window._micLevel()));
  }catch(e){}
  return null;
}

var rotY = 0;
function drawGlobe(t){
  if(!ctx || !canvas) return;
  var w = canvas.clientWidth, h = canvas.clientHeight;
  if(canvas.width !== w*2){ canvas.width = w*2; canvas.height = h*2; ctx.scale(2,2); }
  ctx.clearRect(0,0,w,h);
  var cx = w/2, cy = h/2, radius = Math.min(w,h)*0.42;
  var lvl = audioLevel();
  var pulse = lvl===null ? (0.5 + 0.5*Math.sin(t/900)) : lvl;
  rotY += 0.0018 + pulse*0.004;
  var cs = Math.cos(rotY), sn = Math.sin(rotY);
  var css = getComputedStyle(document.documentElement);
  var primary = (css.getPropertyValue("--primary")||"#22c3ff").trim() || "#22c3ff";

  var proj = points.map(function(p){
    var x = p.x*cs - p.z*sn, z = p.x*sn + p.z*cs, y = p.y;
    var scale = radius * (1 + pulse*0.15);
    return { sx: cx + x*scale, sy: cy + y*scale, depth: z };
  }).sort(function(a,b){ return a.depth - b.depth; });

  proj.forEach(function(p){
    var op = 0.15 + (p.depth+1)/2 * 0.65;
    ctx.beginPath();
    ctx.fillStyle = primary;
    ctx.globalAlpha = op;
    var r = 0.7 + (p.depth+1)/2 * 1.3;
    ctx.arc(p.sx, p.sy, r, 0, Math.PI*2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;
}

var frameCounter = 0;
function tick(t){
  if(!running) return;
  drawGlobe(t);
  frameCounter++;
  rafId = requestAnimationFrame(tick);
}

/* ---- relógio ---- */
function updateClock(){
  var now = new Date();
  var timeEl = document.getElementById("faceTime"), dateEl = document.getElementById("faceDate");
  if(timeEl) timeEl.textContent = now.toLocaleTimeString("pt-BR", { hour:"2-digit", minute:"2-digit", second:"2-digit" });
  if(dateEl) dateEl.textContent = now.toLocaleDateString("pt-BR", { weekday:"long", day:"2-digit", month:"long" }).toUpperCase();
}

/* ---- espelha o estado real do orbe do dashboard, se existir (sem tocar no código original) ---- */
var STATE_MAP = { "OCIOSO":"idle", "OUVINDO":"listening", "PENSANDO":"thinking", "FALANDO":"speaking" };
function setFaceState(label){
  var key = STATE_MAP[label] || "idle";
  faceMode.setAttribute("data-s", key);
  var el = document.getElementById("faceStateLabel");
  if(el) el.textContent = key === "idle" ? "ONLINE" : label;
}
function bridgeOrbStatus(){
  try{
    var el = document.getElementById("orbStatus");
    if(!el) return;
    setFaceState(el.textContent.trim());
    var mo = new MutationObserver(function(){ setFaceState(el.textContent.trim()); });
    mo.observe(el, { childList:true, characterData:true, subtree:true });
  }catch(e){}
}
function bridgeLegend(){
  try{
    var el = document.getElementById("jarvisLine");
    var legend = document.getElementById("faceLegend");
    if(!el || !legend) return;
    legend.textContent = el.textContent || "—";
    var mo = new MutationObserver(function(){ legend.textContent = el.textContent || "—"; });
    mo.observe(el, { childList:true, characterData:true, subtree:true });
  }catch(e){}
}
// pontos de extensão genéricos, caso o app um dia exponha esses globais
try{
  if(Array.isArray(window._orbSetters)) window._orbSetters.push(function(state){ setFaceState(state); });
}catch(e){}
try{
  if(typeof window._setTranscript === "function"){
    var orig = window._setTranscript;
    window._setTranscript = function(){ var r = orig.apply(this, arguments); try{ var l=document.getElementById("faceLegend"); if(l && arguments[0]) l.textContent = arguments[0]; }catch(e){} return r; };
  }
}catch(e){}

/* ---- vitals ---- */
var lastFpsCheck = performance.now(), lastFrameCounter = 0;
function measureFps(){
  var now = performance.now();
  var elapsed = now - lastFpsCheck;
  var frames = frameCounter - lastFrameCounter;
  lastFpsCheck = now; lastFrameCounter = frameCounter;
  if(elapsed <= 0) return 0;
  return Math.round(frames * 1000 / elapsed);
}
function updateVitals(){
  try{
    var fps = measureFps();
    setBar("fvFps","fvFpsN", Math.min(100, fps/60*100), fps);
  }catch(e){}
  try{
    if(performance.memory){
      var used = performance.memory.usedJSHeapSize, limit = performance.memory.jsHeapSizeLimit;
      setBar("fvHeap","fvHeapN", (used/limit)*100, Math.round(used/1048576)+"MB");
    } else { setBar("fvHeap","fvHeapN", 0, "—"); }
  }catch(e){ setBar("fvHeap","fvHeapN", 0, "—"); }
  try{
    var lvl = audioLevel();
    if(lvl===null){ setBar("fvAudio","fvAudioN", 8+8*Math.sin(Date.now()/700), "demo"); }
    else{ setBar("fvAudio","fvAudioN", lvl*100, Math.round(lvl*100)+"%"); }
  }catch(e){}
  try{
    var brainCountEl = document.getElementById("brainCount");
    if(brainCountEl){
      var m = /(\d+)\s*notas/.exec(brainCountEl.textContent||"");
      var n = m ? parseInt(m[1],10) : null;
      setBar("fvNotes","fvNotesN", n ? Math.min(100, n*4) : 0, n===null ? "—" : n);
    }
  }catch(e){}
}
function setBar(barId, numId, pct, label){
  var bar = document.getElementById(barId), num = document.getElementById(numId);
  if(bar) bar.style.width = Math.max(0, Math.min(100, pct)) + "%";
  if(num) num.textContent = label;
}

/* ---- status ---- */
function updateStatus(){
  var antennaDot = document.getElementById("fsAntenna");
  fetch("http://127.0.0.1:4242/ping", { cache:"no-store" })
    .then(function(r){ if(antennaDot) antennaDot.className = "face-dot " + (r.ok ? "ok" : "warn"); })
    .catch(function(){ if(antennaDot) antennaDot.className = "face-dot off"; });

  try{
    var vozDot = document.getElementById("fsVoz");
    if(vozDot) vozDot.className = "face-dot " + (("speechSynthesis" in window) ? "ok" : "off");
  }catch(e){}

  try{
    var acaoDot = document.getElementById("fsAcao"), acaoLbl = document.getElementById("fsAcaoLabel");
    var badge = document.getElementById("actionEmailBadge");
    if(badge){
      var hidden = badge.classList.contains("hidden");
      var n = parseInt(badge.textContent||"0",10) || 0;
      if(acaoDot) acaoDot.className = "face-dot " + (hidden || n===0 ? "off" : "warn");
      if(acaoLbl) acaoLbl.textContent = "E-mails ação: " + (hidden ? "0" : n);
    }
  }catch(e){}
}

/* ---- logs ---- */
var LOG_MAX = 8;
function pushLog(msg){
  var el = document.getElementById("faceLogs");
  if(!el) return;
  var time = new Date().toLocaleTimeString("pt-BR", { hour:"2-digit", minute:"2-digit", second:"2-digit" });
  var line = document.createElement("div");
  line.textContent = "[" + time + "] " + msg;
  el.appendChild(line);
  while(el.children.length > LOG_MAX) el.removeChild(el.firstChild);
}

/* ---- feeds ---- */
function updateFeeds(){
  var el = document.getElementById("faceFeeds");
  if(!el) return;
  try{
    var items = document.querySelectorAll(".newsItem");
    if(items.length){
      var html = "";
      for(var i=0;i<Math.min(4, items.length);i++){
        var t = items[i].childNodes[0] ? items[i].childNodes[0].textContent.trim() : items[i].textContent.trim();
        var href = items[i].getAttribute("href") || "#";
        html += '<a href="'+href+'" target="_blank" rel="noopener">' + t.slice(0,60) + '</a>';
      }
      el.innerHTML = html;
    } else {
      el.innerHTML = '<div style="color:var(--txt3,#6b7690);">aguardando sync…</div>';
    }
  }catch(e){}
}

/* ---- ticker ---- */
function updateTicker(){
  var el = document.getElementById("faceTicker");
  if(!el) return;
  var agendaTxt = "—", emailTxt = "—", notesTxt = "—";
  try{
    var ac = document.getElementById("agendaContent");
    if(ac){ var m = ac.querySelectorAll(".eventRow"); if(m.length) agendaTxt = m.length + " evt"; else if(!/ANTENA OFFLINE/.test(ac.textContent||"")) agendaTxt = "0 evt"; }
  }catch(e){}
  try{
    var badge = document.getElementById("actionEmailBadge");
    if(badge) emailTxt = badge.classList.contains("hidden") ? "0" : (badge.textContent||"0");
  }catch(e){}
  try{
    var bc = document.getElementById("brainCount");
    if(bc){ var mm = /(\d+)\s*notas/.exec(bc.textContent||""); if(mm) notesTxt = mm[1]; }
  }catch(e){}
  el.innerHTML = "AGENDA HOJE <b>"+agendaTxt+"</b> · E-MAILS AÇÃO <b>"+emailTxt+"</b> · NOTAS <b>"+notesTxt+"</b>";
}

/* ---- ativação ---- */
function startLoops(){
  if(running) return;
  running = true;
  rafId = requestAnimationFrame(tick);
  updateClock(); updateVitals(); updateStatus(); pushLog("núcleo sincronizado"); pushLog("varredura ok — sistemas nominais"); updateFeeds(); updateTicker();
  intervalIds.push(setInterval(updateClock, 1000));
  intervalIds.push(setInterval(function(){ if(faceMode.classList.contains("on")) updateVitals(); }, 1000));
  intervalIds.push(setInterval(function(){ if(faceMode.classList.contains("on")) updateStatus(); }, 15000));
  intervalIds.push(setInterval(function(){ if(faceMode.classList.contains("on")) updateFeeds(); }, 15000));
  intervalIds.push(setInterval(function(){ if(faceMode.classList.contains("on")) updateTicker(); }, 15000));
}
function stopLoops(){
  running = false;
  if(rafId) cancelAnimationFrame(rafId);
  intervalIds.forEach(function(id){ clearInterval(id); });
  intervalIds = [];
}

window.faceModeToggle = function(force){
  var willOpen = typeof force === "boolean" ? force : !faceMode.classList.contains("on");
  if(willOpen){
    faceMode.classList.add("on");
    startLoops();
  } else {
    faceMode.classList.remove("on");
    stopLoops();
  }
};

document.addEventListener("keydown", function(e){
  var tag = (document.activeElement && document.activeElement.tagName) || "";
  if(tag === "INPUT" || tag === "TEXTAREA") return;
  if(e.key === "f" || e.key === "F"){ window.faceModeToggle(); }
  else if(e.key === "Escape" && faceMode.classList.contains("on")){ window.faceModeToggle(false); }
});

faceMode.addEventListener("click", function(e){
  if(e.target.closest(".face-orb-wrap")){
    try{ if(typeof window.toggleListening === "function") window.toggleListening(); }catch(err){}
    try{
      var micBtn = document.getElementById("micBtn");
      if(micBtn) micBtn.click();
    }catch(err){}
  }
});

function injectToggleButton(){
  try{
    var brand = document.querySelector("header.topbar .brand");
    if(!brand) return;
    var btn = document.createElement("button");
    btn.id = "faceToggleBtn"; btn.className = "iconBtn"; btn.title = "FACE (tecla F)";
    btn.textContent = "🛰";
    btn.addEventListener("click", function(){ window.faceModeToggle(); });
    brand.insertAdjacentElement("afterend", btn);
  }catch(e){}
}

function init(){
  injectToggleButton();
  bridgeOrbStatus();
  bridgeLegend();
  updateClock();

  // FACE só abre por pedido explícito: botão 🛰, tecla F, ou ?face=1 na URL.
  // (a entrada automática após ativar foi desligada — cobria o dashboard e confundia)
  var params = new URLSearchParams(window.location.search);
  if(params.get("face") === "1"){
    window.faceModeToggle(true);
  }
}

if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
else init();

})();
</script>
