        <div class="emailExcerpt">${escapeXml((e.excerpt||"").slice(0,300))}</div>
      </div>
      <div class="emailTime">${relativeTime(e.date)}</div>
    </div>`).join("");
}
function renderEmailsPanel(allEmails){
  const el = document.getElementById("emailsContent");
  if(!el) return;
  if(antennaOnline === false){ el.innerHTML = offlineNoteHTML(); return; }
  if(!emailAccounts.some(a=>a.email && a.appPassword)){ el.innerHTML = '<div class="offlineNote">Nenhuma conta de e-mail configurada. Clique em ⚙ pra adicionar.</div>'; return; }
  const errors = allEmails.filter(e=>e.error);
  const valid = allEmails.filter(e=>!e.error);
