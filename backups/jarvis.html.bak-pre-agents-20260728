function buildSecondBrainText(){
  const byArea = {};
  notes.forEach(n => {
    if(!byArea[n.area]) byArea[n.area] = [];
    byArea[n.area].push(n);
  });
  let out = "";
  Object.keys(AREA).forEach(areaKey => {
    const list = byArea[areaKey];
    if(!list || !list.length) return;
    out += `\n[${AREA[areaKey].label}]\n`;
    list.forEach(n => { out += `- ${n.title}: ${n.body}\n`; });
  });
  return out;
}

function buildSystemPrompt(){
  return `Você é ${CONFIG.name}, um assistente pessoal de voz para ${CONFIG.address}. `+
  `Sua personalidade é ${CONFIG.persona}. Trate-o sempre como "${CONFIG.address}". `+
  `Responda SEMPRE em português do Brasil, de forma curta e falada (2 a 4 frases), sem emojis e sem markdown, `+
  `como se estivesse conversando de voz com ele.\n\n`+
  `Aqui está o SECOND BRAIN completo de ${CONFIG.address} — use esse contexto para personalizar toda resposta:\n`+
  buildSecondBrainText() +
  `\n\nPROTOCOLO DE MEMÓRIA VIVA: se ${CONFIG.address} revelar algo novo e duradouro sobre a vida dele (uma meta, um projeto, uma decisão, um fato pessoal), `+
  `termine sua resposta com uma linha no formato EXATO [[SAVE:area|titulo|texto]], onde area é uma destas: metas, trabalho, projetos, financas, aprendizado, saude, relacoes, meta. `+
  `Se já existir uma nota com esse título, ela será atualizada; senão nasce uma nova. Inclua essa linha somente quando houver algo realmente novo para guardar.`;
}

async function submitUserText(text){
  if(!text || busy) return;
  busy = true;
  document.getElementById("youLine").textContent = text;
  history.push({ role:"user", content: text });
  setOrbState("thinking");
  stopRecognitionSoft();

  const apiKey = (document.getElementById("apiKeyInput").value || localStorage.getItem("anthropic_key") || "").trim();
  if(!apiKey){
    const msg = "Preciso de uma chave de API da Anthropic. Cole sua chave no campo no topo da tela.";
    setJarvisLine(msg);
    speak(msg, endTurn);
    return;
  }

  try{
    const res = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: {
        "x-api-key": apiKey,
        "anthropic-version": "2023-06-01",
        "anthropic-dangerous-direct-browser-access": "true",
        "content-type": "application/json"
      },
      body: JSON.stringify({
        model: CONFIG.model,
        max_tokens: 400,
        system: buildSystemPromptFull(),
        messages: history
      })
    });

    if(!res.ok){
      const msg = "Deu erro na chamada da API. Verifique se a chave está correta.";
      setJarvisLine(msg);
      speak(msg, endTurn);
      return;
    }

    const data = await res.json();
    let replyText = (data.content && data.content[0] && data.content[0].text) ? data.content[0].text : "";
    if(!replyText){
      const msg = "Não recebi resposta do modelo. Tente novamente.";
      setJarvisLine(msg);
      speak(msg, endTurn);
      return;
    }

    history.push({ role:"assistant", content: replyText });

    const saveRegex = /\[\[SAVE:([a-z_]+)\|([^|]+)\|([\s\S]+?)\]\]/;
    const match = replyText.match(saveRegex);
    let savedNoteId = null;
    if(match){
      const [, area, title, body] = match;
      savedNoteId = applySaveMemory(area.trim(), title.trim(), body.trim());
      replyText = replyText.replace(saveRegex, "").trim();
    }

    setJarvisLine(replyText);
    speak(replyText, endTurn);

    if(savedNoteId){ renderGraph(); blinkNode(savedNoteId); }

  }catch(e){
    const msg = "Não consegui me conectar à internet agora. Verifique sua conexão.";
    setJarvisLine(msg);
    speak(msg, endTurn);
  }
}

function endTurn(){
  busy = false;
  setOrbState("idle");
  startRecognition();
}

function applySaveMemory(area, title, body){
  if(!AREA[area]) area = "meta";
  const existing = notes.find(n => normalize(n.title) === normalize(title));
  if(existing){
    existing.body = body;
    existing.area = area;
    saveNotes();
    return existing.id;
  } else {
    const id = "note_" + Date.now();
    notes.push({ id, area, title, body });
    saveNotes();
    return id;
  }
}

/* ============ TTS ============ */
function loadVoices(){
  voices = speechSynthesis.getVoices();
  const ptBrVoices = voices.filter(v => v.lang && v.lang.toLowerCase() === "pt-br");
  const ptVoices = ptBrVoices.length ? ptBrVoices : voices.filter(v => v.lang && v.lang.toLowerCase().startsWith("pt"));
  const pool = ptVoices.length ? ptVoices : voices;
  // prioriza uma voz masculina grave e formal, no estilo do Jarvis do Homem de Ferro
  const jarvisNames = /daniel|antonio|antônio|ricardo|felipe|guy|george|david|male|homem/i;
  chosenVoice = pool.find(v => jarvisNames.test(v.name)) || pool.find(v => v.default) || pool[0] || voices[0] || null;
}
if("speechSynthesis" in window){
  speechSynthesis.onvoiceschanged = loadVoices;
  loadVoices();
}

function speak(text, onDone){
  if(!("speechSynthesis" in window)){ if(onDone) onDone(); return; }
  busy = true;
  setOrbState("speaking");
  speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = "pt-BR";
  if(chosenVoice) utter.voice = chosenVoice;
  // tom mais grave e ritmo mais calmo, no estilo do Jarvis do Homem de Ferro
  utter.pitch = 0.82;
  utter.rate = 0.95;
  let finished = false;
  const finish = () => {
    if(finished) return;
    finished = true;
    clearTimeout(safetyTimer);
    busy = false;
    if(onDone) onDone();
  };
  utter.onend = finish;
  utter.onerror = finish;
  // alguns navegadores nunca disparam onend/onerror (bug conhecido) — evita travar em "busy" pra sempre
  const safetyTimer = setTimeout(finish, Math.max(4000, text.length * 90));
  speechSynthesis.speak(utter);
}

