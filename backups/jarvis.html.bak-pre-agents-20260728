async function fetchNewsForTopic(topic, force){
  const cached = newsCache[topic];
  if(!force && cached && (Date.now()-cached.ts) < 55*1000) return cached.items;
  const url = `https://news.google.com/rss/search?q=${encodeURIComponent(topic)}&hl=pt-BR&gl=BR&ceid=BR:pt-419`;
  try{
    const xmlText = await proxyFetchText(url);
    const doc = new DOMParser().parseFromString(xmlText, "text/xml");
    const items = Array.from(doc.querySelectorAll("item")).slice(0,5).map(it => ({
      title: (it.querySelector("title")?.textContent || "").replace(/\s-\s[^-]+$/,""),
      link: it.querySelector("link")?.textContent || "",
      source: it.querySelector("source")?.textContent || "",
      pubDate: it.querySelector("pubDate")?.textContent || ""
    }));
    newsCache[topic] = { items, ts: Date.now() };
    saveNewsCache();
    return items;
  }catch(e){ return cached ? cached.items : []; }
}
async function fetchAllNews(force){
  const sub = document.getElementById("newsSub");
  if(sub) sub.textContent = newsTopics.join(" · ");
  const content = document.getElementById("newsContent");
  if(!content) return;
  if(antennaOnline === false){ content.innerHTML = offlineNoteHTML(); return; }
  if(!newsTopics.length){ content.innerHTML = '<div class="offlineNote">Nenhum assunto configurado.</div>'; return; }
  let html = "";
  for(const topic of newsTopics){
    const items = await fetchNewsForTopic(topic, force);
    html += `<div class="newsTopic"><h3>${escapeXml(topic)}</h3>` +
      (items.length ? items.map(it => `<a class="newsItem" href="${escapeAttr(it.link)}" target="_blank" rel="noopener">${escapeXml(it.title)}<div class="newsSource">${escapeXml(it.source)} · ${relativeTime(it.pubDate)}</div></a>`).join("") :
        '<div style="color:var(--muted);font-size:0.8rem;">sem manchetes agora</div>') + `</div>`;
  }
  content.innerHTML = html;
}

/* ============ CLIMA (Open-Meteo, direto do navegador) ============ */
async function geocodeCity(city){
  if(weatherGeoCache[city]) return weatherGeoCache[city];
  try{
    const res = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=pt&format=json`);
    const data = await res.json();
    const r = data.results && data.results[0];
    if(!r) return null;
    const geo = { lat:r.latitude, lon:r.longitude };
    weatherGeoCache[city] = geo;
    saveJSON("jarvis_weather_geo", weatherGeoCache);
    return geo;
  }catch(e){ return null; }
}
async function fetchWeather(city){
  const geo = await geocodeCity(city);
  if(!geo) return null;
  try{
    const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${geo.lat}&longitude=${geo.lon}&current=temperature_2m,weather_code&timezone=auto`);
    const data = await res.json();
    return data.current ? { temp: Math.round(data.current.temperature_2m), code: data.current.weather_code } : null;
  }catch(e){ return null; }
}
function weatherCodeLabel(code){
  if(code===0) return "céu limpo";
  if([1,2,3].includes(code)) return "parcialmente nublado";
  if([45,48].includes(code)) return "neblina";
  if([51,53,55,56,57].includes(code)) return "garoa";
  if([61,63,65,66,67,80,81,82].includes(code)) return "chuva";
  if([71,73,75,77,85,86].includes(code)) return "neve";
  if([95,96,99].includes(code)) return "tempestade";
  return "tempo instável";
}

/* ============ MORNING DIGEST ============ */
function buildOfflineDigest(dateLabel, weatherText, todaysEvents, actionSummaries, newsHeadlines, goalNotes){
  let t = `Bom dia, ${CONFIG.address}. Hoje é ${dateLabel}. `;
  if(weatherText) t += `Tempo: ${weatherText}. `;
  t += todaysEvents.length ? `Sua agenda: ${todaysEvents.map(e=>`${e.allDay?"dia todo":formatTime(e.startMs)} ${e.title}`).join(", ")}. ` : "Sua agenda de hoje está livre. ";
  t += actionSummaries.length ? `E-mails pedindo ação: ${actionSummaries.join("; ")}. ` : "Nenhum e-mail pedindo ação. ";
  const headlineList = Object.entries(newsHeadlines).filter(([,v])=>v.length).map(([k,v])=>`${k}: ${v[0]}`).join(" · ");
  if(headlineList) t += `Manchetes: ${headlineList}. `;
  if(goalNotes.length) t += `Foco do dia: ${goalNotes[0]}.`;
  return t;
}
async function buildAndShowDigest(speakToo){
  const card = document.getElementById("digestCard");
  card.textContent = "Montando seu briefing…";
  switchTab("digest");

  const dateLabel = new Intl.DateTimeFormat("pt-BR", { timeZone:DISPLAY_TZ, weekday:"long", day:"2-digit", month:"long" }).format(new Date());
  const todayKey = dayKey(Date.now());
  const todaysEvents = calendarEvents.filter(e=>!e.error && dayKey(e.startMs)===todayKey);
  const actionSummaries = Object.keys(emailTriageCache).filter(id=>emailTriageCache[id].balde==="acao").slice(0,5).map(id=>emailTriageCache[id].resumo);
  const totalAcao = actionEmailCount();

  let weatherText = "";
  if(digestSettings.weather){
    const wPrimary = await fetchWeather(digestSettings.citiesPrimary);
    const wSecondary = digestSettings.citySecondary ? await fetchWeather(digestSettings.citySecondary) : null;
    if(wPrimary){
      weatherText = `${digestSettings.citiesPrimary}: ${wPrimary.temp}°C, ${weatherCodeLabel(wPrimary.code)}`;
      if(wSecondary && Math.abs(wSecondary.temp - wPrimary.temp) >= 3){
        weatherText += ` · ${digestSettings.citySecondary}: ${wSecondary.temp}°C, ${weatherCodeLabel(wSecondary.code)}`;
      }
    }
  }
  const newsHeadlines = {};
  newsTopics.forEach(topic => { newsHeadlines[topic] = (newsCache[topic]?.items || []).slice(0,3).map(i=>i.title); });
  const goalNotes = notes.filter(n=>n.area==="metas").slice(0,2).map(n=>`${n.title}: ${n.body}`);

  const apiKey = (document.getElementById("apiKeyInput").value || localStorage.getItem("anthropic_key") || "").trim();
  let digestText = null;
  if(apiKey){
    try{
      const packet = { data:dateLabel, clima: weatherText || "sem dado de clima",
        agenda_hoje: todaysEvents.map(e => `${e.allDay?"dia todo":formatTime(e.startMs)} ${e.title}`),
        emails_acao: actionSummaries, total_emails_acao: totalAcao, manchetes: newsHeadlines, metas: goalNotes };
      const res = await fetch("https://api.anthropic.com/v1/messages", {
        method:"POST",
        headers:{ "x-api-key":apiKey, "anthropic-version":"2023-06-01", "anthropic-dangerous-direct-browser-access":"true", "content-type":"application/json" },
        body: JSON.stringify({
          model: CONFIG.model,
          max_tokens: digestSettings.length==="medio" ? 800 : 500,
          system: `Você é ${CONFIG.name}, assistente de ${CONFIG.address}. Personalidade: ${CONFIG.persona}. Monte um Morning Digest corrido e falável em português do Brasil, natural, ${digestSettings.length==="medio"?"cerca de 1 minuto falado":"cerca de 30 segundos falado"}, cumprimentando ${CONFIG.address}, cobrindo clima (se houver), agenda de hoje, e-mails que pedem ação, principais manchetes, terminando com uma frase de foco do dia conectada às metas. Sem emojis, sem markdown.`,
          messages: [{ role:"user", content: JSON.stringify(packet) }]
        })
      });
      if(res.ok){
        const data = await res.json();
        digestText = (data.content && data.content[0] && data.content[0].text) || null;
      }
    }catch(e){ digestText = null; }
  }
  if(!digestText) digestText = buildOfflineDigest(dateLabel, weatherText, todaysEvents, actionSummaries, newsHeadlines, goalNotes);

  card.textContent = digestText;
  localStorage.setItem("jarvis_last_digest", todayKey);
  if(speakToo && digestSettings.speak) speak(digestText);
}

/* ============ ROTEADOR — comandos locais primeiro, senão cai na Parte 1 ============ */
function routeUserText(text){
  const n = normalize(text);

  if(/minha agenda|o que eu tenho hoje|compromissos de hoje/.test(n)){
    document.getElementById("youLine").textContent = text;
    switchTab("agenda");
    const todayKey = dayKey(Date.now());
    const todays = calendarEvents.filter(e=>!e.error && dayKey(e.startMs)===todayKey);
    const msg = todays.length ? `Sua agenda de hoje: ${todays.map(e=>`${e.allDay?"dia todo":formatTime(e.startMs)} ${e.title}`).join(", ")}.` : "Você não tem nada marcado hoje.";
    setJarvisLine(msg); speak(msg, endTurn); return;
  }
  if(/proximo compromisso|proxima reuniao/.test(n)){
    document.getElementById("youLine").textContent = text;
    const now = Date.now();
    const next = calendarEvents.find(e=>!e.error && !e.allDay && e.startMs>now);
    const msg = next ? `Seu próximo compromisso é ${next.title}, ${countdownLabel(next.startMs-now)}.` : "Você não tem mais nada marcado nos próximos dias.";
    setJarvisLine(msg); speak(msg, endTurn); return;
  }
  if(/agenda da semana|proximos dias/.test(n)){
    document.getElementById("youLine").textContent = text;
    switchTab("agenda");
    const groups = groupEventsByDay(calendarEvents.filter(e=>!e.error));
    const msg = groups.length ? groups.slice(0,4).map(g=>`${g.label}: ${g.events.length} evento(s)`).join(". ") : "Sua semana está livre.";
    setJarvisLine(msg); speak(msg, endTurn); return;
  }
  if(/meus e ?mails/.test(n)){
    document.getElementById("youLine").textContent = text;
    switchTab("emails");
    const acao = actionEmailCount();
    const resumos = Object.keys(emailTriageCache).filter(id=>emailTriageCache[id].balde==="acao").slice(0,3).map(id=>emailTriageCache[id].resumo);
    const msg = acao ? `Você tem ${acao} e-mail(s) pedindo ação: ${resumos.join("; ")}.` : "Nenhum e-mail pedindo ação agora.";
    setJarvisLine(msg); speak(msg, endTurn); return;
  }
  if(/tem email importante|e ?mail importante/.test(n)){
    document.getElementById("youLine").textContent = text;
    const acao = actionEmailCount();
    const msg = acao ? `Sim, ${acao} e-mail(s) pedindo ação.` : "Não, nenhum e-mail importante agora.";
    setJarvisLine(msg); speak(msg, endTurn); return;
  }
  const newsTopicMatch = n.match(/noticias? de (.+)/);
  if(newsTopicMatch){
    document.getElementById("youLine").textContent = text;
    switchTab("news");
    const topic = newsTopicMatch[1].trim();
    fetchNewsForTopic(topic).then(items => {
      const msg = items.length ? `Manchetes de ${topic}: ${items.slice(0,3).map(i=>i.title).join(". ")}.` : `Não achei manchetes de ${topic} agora.`;
      setJarvisLine(msg); speak(msg, endTurn);
    });
    return;
  }
  if(/^noticias$|noticias principais/.test(n)){
    document.getElementById("youLine").textContent = text;
    switchTab("news");
    const all = newsTopics.map(t => (newsCache[t]?.items||[])[0]).filter(Boolean);
    const msg = all.length ? `Principais manchetes: ${all.map(i=>i.title).join(". ")}.` : "Ainda não tenho manchetes carregadas.";
    setJarvisLine(msg); speak(msg, endTurn); return;
  }
  if(/^bom dia\b/.test(n)){
    document.getElementById("youLine").textContent = text;
    buildAndShowDigest(true);
    return;
  }
  if(/atualizar e ?mails?/.test(n)){
    document.getElementById("youLine").textContent = text;
    const msg = "Atualizando seus e-mails.";
    setJarvisLine(msg); speak(msg, endTurn);
    fetchAllEmailAccounts();
    return;
  }
  if(/atualizar noticias/.test(n)){
    document.getElementById("youLine").textContent = text;
    const msg = "Atualizando as notícias.";
    setJarvisLine(msg); speak(msg, endTurn);
    fetchAllNews(true);
    return;
  }

  submitUserText(text);
}

