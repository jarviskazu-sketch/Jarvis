/* ============ TEMPO / TIMEZONE ============ */
function zonedWallClockToUtcMs(y,mo,d,h,mi,s,tzid){
  try{
    const asUTC = Date.UTC(y,mo,d,h,mi,s);
    const fmt = new Intl.DateTimeFormat("en-US", { timeZone:tzid, hour12:false,
      year:"numeric", month:"2-digit", day:"2-digit", hour:"2-digit", minute:"2-digit", second:"2-digit" });
    const parts = fmt.formatToParts(new Date(asUTC));
    const get = t => +parts.find(p=>p.type===t).value;
    let hh = get("hour"); if(hh===24) hh=0;
    const asIfUTC = Date.UTC(get("year"), get("month")-1, get("day"), hh, get("minute"), get("second"));
    const offset = asIfUTC - asUTC;
    return asUTC - offset;
  }catch(e){
    return Date.UTC(y,mo,d,h,mi,s) + 3*3600*1000;
  }
}
function startOfTodayMs(){
  const fmt = new Intl.DateTimeFormat("en-CA", { timeZone: DISPLAY_TZ, year:"numeric", month:"2-digit", day:"2-digit" });
  const parts = fmt.formatToParts(new Date());
  const get = t => +parts.find(p=>p.type===t).value;
  return zonedWallClockToUtcMs(get("year"), get("month")-1, get("day"), 0,0,0, DISPLAY_TZ);
}
function dayKey(ms){
  return new Intl.DateTimeFormat("en-CA", { timeZone: DISPLAY_TZ, year:"numeric", month:"2-digit", day:"2-digit" }).format(new Date(ms));
}
function dayLabelFromKey(key){
  const todayKey = dayKey(Date.now());
  const tmrwKey = dayKey(Date.now()+24*3600*1000);
  if(key === todayKey) return "HOJE";
  if(key === tmrwKey) return "AMANHÃ";
  const [y,m,d] = key.split("-").map(Number);
  const dow = new Date(Date.UTC(y,m-1,d)).getUTCDay();
  const names = ["DOMINGO","SEGUNDA","TERÇA","QUARTA","QUINTA","SEXTA","SÁBADO"];
  return `${names[dow]} · ${String(d).padStart(2,"0")}/${String(m).padStart(2,"0")}`;
}
function formatTime(ms){
  return new Intl.DateTimeFormat("pt-BR", { timeZone: DISPLAY_TZ, hour:"2-digit", minute:"2-digit" }).format(new Date(ms));
}
function countdownLabel(deltaMs){
  if(deltaMs < 0) return "agora";
  const totalMin = Math.round(deltaMs/60000);
  const h = Math.floor(totalMin/60), m = totalMin%60;
  return h>0 ? `em ${h}h ${m}min` : `em ${m}min`;
}

/* ============ PARSER ICS ============ */
function unfoldICS(text){
  return text.replace(/\r\n/g,"\n").split("\n").reduce((lines, line) => {
    if((line.startsWith(" ") || line.startsWith("\t")) && lines.length){
      lines[lines.length-1] += line.slice(1);
    } else if(line.length){
      lines.push(line);
    }
    return lines;
  }, []);
}
function decodeICSText(s){
  return s.replace(/\\n/gi,"\n").replace(/\\,/g,",").replace(/\\;/g,";").replace(/\\\\/g,"\\");
}
function parseICSLineKV(line){
  const colonIdx = line.indexOf(":");
  if(colonIdx === -1) return null;
  const left = line.slice(0, colonIdx);
  const value = line.slice(colonIdx+1);
  const parts = left.split(";");
  const name = parts[0].toUpperCase();
  const params = {};
  parts.slice(1).forEach(p => {
    const eq = p.indexOf("=");
    if(eq>-1) params[p.slice(0,eq).toUpperCase()] = p.slice(eq+1);
  });
  return { name, params, value };
}
function parseICSDate(value, params){
  const isDateOnly = (params.VALUE === "DATE") || /^\d{8}$/.test(value);
  if(isDateOnly){
    return { allDay:true, y:+value.slice(0,4), m:+value.slice(4,6), d:+value.slice(6,8) };
  }
  const isUTC = value.endsWith("Z");
  const clean = value.replace("Z","");
  const y=+clean.slice(0,4), mo=+clean.slice(4,6), d=+clean.slice(6,8);
  const h=+clean.slice(9,11)||0, mi=+clean.slice(11,13)||0, s=+clean.slice(13,15)||0;
  const ms = isUTC ? Date.UTC(y,mo-1,d,h,mi,s) : zonedWallClockToUtcMs(y,mo-1,d,h,mi,s, params.TZID || DISPLAY_TZ);
  return { allDay:false, ms };
}
function buildEventObj(ev, startDate, calMeta){
  const allDay = startDate.allDay;
  // meio-dia UTC (não meia-noite) evita que o fuso America/Sao_Paulo empurre a data pro dia anterior
  const startMs = allDay ? Date.UTC(startDate.y, startDate.m-1, startDate.d, 12) : startDate.ms;
  let endMs = startMs + 3600*1000;
  if(ev.dtend && !allDay) endMs = ev.dtend.ms;
  return { title: ev.title || "(sem título)", location: ev.location || "", startMs, endMs, allDay,
    calId: calMeta.id, calName: calMeta.name, calColor: calMeta.color };
}
function expandRRule(ev, windowStart, windowEnd){
  const occurrences = [];
  const rule = {};
  ev.rrule.split(";").forEach(p => { const [k,v] = p.split("="); if(k) rule[k]=v; });
  const freq = rule.FREQ;
  if(!freq) return [ev.dtstart];
  const interval = parseInt(rule.INTERVAL||"1",10) || 1;
  const count = rule.COUNT ? parseInt(rule.COUNT,10) : null;
  let until = null;
  if(rule.UNTIL){ const u = parseICSDate(rule.UNTIL, {}); until = u.allDay ? Date.UTC(u.y,u.m-1,u.d,23,59,59) : u.ms; }
  const byday = rule.BYDAY ? rule.BYDAY.split(",") : null;
  const DOW = { SU:0, MO:1, TU:2, WE:3, TH:4, FR:5, SA:6 };
  const start = ev.dtstart;
  const startMs = start.allDay ? Date.UTC(start.y,start.m-1,start.d) : start.ms;
  const excluded = new Set((ev.exdates||[]).map(x => x.allDay ? Date.UTC(x.y,x.m-1,x.d) : x.ms));
  let generated = 0, iter = 0;
  let cursor = new Date(startMs);
  const MAXITER = 3000;
  while(iter++ < MAXITER){
    const occMs = cursor.getTime();
    let matches = true;
    if(freq === "WEEKLY" && byday){
      const dow = cursor.getUTCDay();
      matches = byday.some(bd => DOW[bd.slice(-2)] === dow);
    }
    if(matches){
      if(!excluded.has(occMs)){
        if(occMs >= windowStart - 24*3600*1000 && occMs <= windowEnd){
          occurrences.push(start.allDay
            ? { allDay:true, y:cursor.getUTCFullYear(), m:cursor.getUTCMonth()+1, d:cursor.getUTCDate() }
            : { allDay:false, ms:occMs });
        }
        generated++;
        if(count && generated >= count) break;
      }
    }
    if(until && occMs > until) break;
    if(occMs > windowEnd + 3600*1000) break;
    if(freq === "DAILY") cursor = new Date(cursor.getTime() + interval*24*3600*1000);
    else if(freq === "WEEKLY") cursor = new Date(cursor.getTime() + (byday ? 1 : interval*7)*24*3600*1000);
    else if(freq === "MONTHLY") cursor.setUTCMonth(cursor.getUTCMonth()+interval);
    else if(freq === "YEARLY") cursor.setUTCFullYear(cursor.getUTCFullYear()+interval);
    else break;
  }
  return occurrences;
}
function parseICS(text, calMeta){
  const events = [];
  try{
    const lines = unfoldICS(text);
    let cur = null;
    lines.forEach(line => {
      const t = line.trim();
      if(t === "BEGIN:VEVENT"){ cur = { exdates:[] }; return; }
      if(t === "END:VEVENT"){ if(cur) events.push(cur); cur=null; return; }
      if(!cur) return;
      const kv = parseICSLineKV(t);
      if(!kv) return;
      try{
        if(kv.name === "SUMMARY") cur.title = decodeICSText(kv.value);
        else if(kv.name === "LOCATION") cur.location = decodeICSText(kv.value);
        else if(kv.name === "DTSTART") cur.dtstart = parseICSDate(kv.value, kv.params);
        else if(kv.name === "DTEND") cur.dtend = parseICSDate(kv.value, kv.params);
        else if(kv.name === "RRULE") cur.rrule = kv.value;
        else if(kv.name === "EXDATE") cur.exdates.push(parseICSDate(kv.value, kv.params));
      }catch(e){ /* campo problemático — ignora e segue o evento */ }
    });
  }catch(e){ /* ICS malformado — devolve o que conseguiu até aqui */ }

  const out = [];
  const windowStart = startOfTodayMs();
  const windowEnd = windowStart + 8*24*3600*1000;
  events.forEach(ev => {
    if(!ev.dtstart) return;
    try{
      if(ev.rrule){
        expandRRule(ev, windowStart, windowEnd).forEach(occ => out.push(buildEventObj(ev, occ, calMeta)));
      } else {
        const startMs = ev.dtstart.allDay ? Date.UTC(ev.dtstart.y, ev.dtstart.m-1, ev.dtstart.d) : ev.dtstart.ms;
        if(startMs >= windowStart - 24*3600*1000 && startMs <= windowEnd) out.push(buildEventObj(ev, ev.dtstart, calMeta));
      }
    }catch(e){ /* evento problemático — ignora e segue com os outros */ }
  });
  return out;
}

