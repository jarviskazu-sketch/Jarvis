<style id="design-layer">
/* ══════════════════════════════════════════════════════════════
   DESIGN LAYER — camada de estilo premium, adicionada por último.
   Não altera HTML/JS/IDs/classes — só redefine tokens e aparência.
   Pra trocar o tema inteiro: mexa só no bloco :root abaixo.
   ══════════════════════════════════════════════════════════════ */

:root{
  /* ---- tokens de cor (reaproveitam os nomes originais + novos) ---- */
  --bg: #05060b;
  --bg2: #0a0e1a;
  --theme: #22c3ff;
  --theme-dim: #0a4a66;
  --violet: #8b5cf6;
  --text: #eaf1fc;
  --muted: #8792ab;

  --primary: var(--theme);
  --primary-dim: var(--theme-dim);
  --accent: var(--violet);
  --surface: var(--bg2);
  --card: rgba(14, 20, 36, .58);
  --card-strong: rgba(14, 20, 36, .82);
  --border: rgba(148, 178, 220, .12);
  --border-strong: rgba(34, 195, 255, .38);
  --txt: var(--text);
  --txt2: #aab6cc;
  --txt3: #6b7690;
  --green: #22c55e;
  --red: #ff5547;
  --yellow: #fbbf24;
  --grad: linear-gradient(120deg, var(--primary), var(--accent));

  --radius: 20px;
  --radius-sm: 13px;
  --radius-lg: 26px;
  --ease: cubic-bezier(.22,1,.36,1);
  --dur: .22s;

  --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 24px; --sp-6: 32px; --sp-7: 52px;

  --font: "Space Grotesk", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

@media (prefers-reduced-motion: reduce){
  *, *::before, *::after{ animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
}

html, body{ font-family: var(--font) !important; }

::selection{ background: var(--primary); color: #001018; }

*{ scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
*::-webkit-scrollbar{ width: 9px; height: 9px; }
*::-webkit-scrollbar-track{ background: transparent; }
*::-webkit-scrollbar-thumb{ background: var(--border-strong); border-radius: 999px; }
*::-webkit-scrollbar-thumb:hover{ background: var(--primary); }

:focus-visible{ outline: 2px solid var(--primary); outline-offset: 2px; border-radius: var(--radius-sm); }

/* ---- ambiente / profundidade ---- */
body{
  background:
    radial-gradient(ellipse 900px 600px at 12% -8%, rgba(34,195,255,.10), transparent 60%),
    radial-gradient(ellipse 800px 700px at 100% 10%, rgba(139,92,246,.09), transparent 55%),
    radial-gradient(ellipse 1000px 800px at 50% 120%, rgba(34,195,255,.06), transparent 60%),
    var(--bg) !important;
  background-attachment: fixed, fixed, fixed, fixed;
  position: relative;
}
body::before{
  content: "";
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background-image: radial-gradient(rgba(255,255,255,.035) 1px, transparent 1px);
  background-size: 26px 26px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 30%, #000 30%, transparent 80%);
}
#bootScreen, #activationScreen, #app, #editorOverlay, #settingsOverlay{ position: relative; z-index: 1; }

/* ---- boot screen ---- */
#bootScreen{
  background:
    radial-gradient(ellipse 700px 500px at 50% 40%, rgba(34,195,255,.10), transparent 65%),
    radial-gradient(ellipse at center, #0a1420 0%, #05070c 70%) !important;
}
#bootScreen::after{
  content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .15;
  background: repeating-linear-gradient(to bottom, transparent 0, transparent 3px, rgba(255,255,255,.5) 3px, transparent 4px);
  animation: scanroll 6s linear infinite;
}
@keyframes scanroll{ 0%{ background-position-y: 0; } 100%{ background-position-y: 60px; } }
.boot-title{ letter-spacing: .18em !important; font-family: var(--font) !important; font-weight: 700 !important; }
.boot-sync{ font-family: var(--font) !important; }
.boot-ver{ font-family: var(--font) !important; }

/* ---- activation screen ---- */
#activationScreen{
  background:
    radial-gradient(ellipse 700px 500px at 50% 40%, rgba(139,92,246,.10), transparent 65%),
    radial-gradient(ellipse at center, #0a1420 0%, #05070c 70%) !important;
}
.act-title{ letter-spacing: .18em !important; font-family: var(--font) !important; }
#activateBtn{
  font-family: var(--font) !important; letter-spacing: .14em !important;
  border-radius: 999px !important;
  transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), background var(--dur) var(--ease), color var(--dur) var(--ease) !important;
}
#activateBtn:hover{ transform: translateY(-2px) scale(1.02); }
#activateBtn:active{ transform: translateY(0) scale(.98); }
.act-hint{ font-family: var(--font) !important; }

/* ---- topbar ---- */
header.topbar{
  background: var(--card-strong) !important;
  backdrop-filter: blur(18px) saturate(140%);
  -webkit-backdrop-filter: blur(18px) saturate(140%);
  border-bottom: 1px solid var(--border) !important;
  padding: var(--sp-3) var(--sp-5) !important;
}
header.topbar .brand{
  background: var(--grad);
  -webkit-background-clip: text; background-clip: text; color: transparent !important;
  letter-spacing: .2em !important; font-weight: 700 !important;
}
#apiKeyInput{
  background: rgba(10,16,28,.7) !important; border: 1px solid var(--border) !important;
  border-radius: var(--radius-sm) !important; font-family: var(--font) !important;
  transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
#apiKeyInput:focus{ border-color: var(--border-strong) !important; box-shadow: 0 0 0 3px rgba(34,195,255,.12); }
#apiKeyStatus{ font-family: var(--font) !important; }
#gearBtn{ transition: transform var(--dur) var(--ease); }
#gearBtn:hover{ transform: rotate(35deg); }

/* ---- orb area ---- */
#orbWrap{ filter: drop-shadow(0 0 34px rgba(34,195,255,.28)); transition: filter var(--dur) var(--ease); }
#orbWrap:hover{ filter: drop-shadow(0 0 46px rgba(34,195,255,.4)); }
.orb-status{ font-family: var(--font) !important; letter-spacing: .28em !important; font-weight: 600; }
.transcript .jarvis{ font-family: var(--font) !important; }
.transcript .you{ font-family: var(--font) !important; }

#textInput{
  background: rgba(10,16,28,.6) !important; border: 1px solid var(--border) !important;
  border-radius: var(--radius-sm) !important; font-family: var(--font) !important;
  transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
}
#textInput:focus{ border-color: var(--border-strong) !important; box-shadow: 0 0 0 3px rgba(34,195,255,.12); }
.iconBtn{
