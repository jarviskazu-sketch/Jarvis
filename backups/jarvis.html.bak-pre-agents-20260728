/* pede a permissão de microfone UMA vez, de forma explícita, antes de usar o SpeechRecognition */
function requestMicAccess(onGranted){
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    onGranted();
    return;
  }
  navigator.mediaDevices.getUserMedia({ audio: true })
    .then((stream) => {
      stream.getTracks().forEach(t => t.stop());
      micBlocked = false;
      onGranted();
    })
    .catch(() => {
      micBlocked = true;
      showError("Permissão de microfone negada. Libere o acesso ao microfone para usar a voz.");
    });
}

