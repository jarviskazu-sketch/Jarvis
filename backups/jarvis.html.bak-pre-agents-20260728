async function fetchAllCalendars(){
  const results = [];
  for(const cal of calendars){
    if(!cal.url) continue;
    try{
      const text = await proxyFetchText(cal.url);
      results.push(...parseICS(text, cal));
    }catch(e){
      results.push({ error:true, calId:cal.id, calName:cal.name, message:"não consegui carregar essa agenda" });
    }
  }
  results.sort((a,b) => (a.startMs||0) - (b.startMs||0));
  calendarEvents = results;
  renderAgendaPanel();
  return results;
}
function groupEventsByDay(events){
  const groups = {}, order = [];
  events.forEach(ev => {
    const k = dayKey(ev.startMs);
    if(!groups[k]){ groups[k]=[]; order.push(k); }
    groups[k].push(ev);
  });
  return order.map(k => ({ label: dayLabelFromKey(k), events: groups[k] }));
}
function renderAgendaPanel(){
  const el = document.getElementById("agendaContent");
  if(!el) return;
  if(antennaOnline === false){ el.innerHTML = offlineNoteHTML(); return; }
  if(!calendars.some(c=>c.url)){ el.innerHTML = '<div class="offlineNote">Nenhuma agenda configurada ainda. Clique em ⚙ e cole o link ICS de cada agenda.</div>'; return; }
  const errors = calendarEvents.filter(e=>e.error);
  const events = calendarEvents.filter(e=>!e.error);
  let html = "";
  errors.forEach(e => { html += `<div class="offlineNote" style="margin-bottom:8px;">⚠ Agenda "${escapeXml(e.calName)}": ${escapeXml(e.message)}.</div>`; });
  const now = Date.now();
  const next = events.find(e => !e.allDay && e.startMs > now);
  if(next) html += `<div class="agendaCountdown">⏱ Próximo: ${escapeXml(next.title)} — ${countdownLabel(next.startMs-now)}</div>`;
  const groups = groupEventsByDay(events);
  groups.forEach(g => {
    html += `<div class="dayGroupLabel">${g.label}</div>`;
    g.events.forEach(ev => {
      html += `<div class="eventRow">
        <div class="eventDot" style="background:${ev.calColor}"></div>
        <div class="eventTime">${ev.allDay ? "DIA TODO" : formatTime(ev.startMs)}</div>
        <div class="eventBody">
          <div class="eventTitle">${escapeXml(ev.title)}</div>
          ${ev.location ? `<div class="eventLoc">📍 ${escapeXml(ev.location)}</div>` : ""}
        </div>
      </div>`;
    });
  });
  el.innerHTML = html || '<div class="offlineNote">Nenhum evento nos próximos 7 dias.</div>';
}
function todayEventsCompactText(){
  const todayKey = dayKey(Date.now());
  const todays = calendarEvents.filter(e => !e.error && dayKey(e.startMs) === todayKey);
  if(!todays.length) return "sem compromissos hoje";
  return todays.map(e => `${e.allDay?"dia todo":formatTime(e.startMs)} ${e.title}`).join(" · ");
}

