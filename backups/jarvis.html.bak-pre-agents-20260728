/* ============ SECOND BRAIN GRAPH ============ */
function connectionCount(id){
  return REL.filter(([a,b]) => a===id || b===id).length +
         notes.filter(n2 => customRelCount(id)).length; // placeholder no-op
}
function customRelCount(){ return false; }

function renderGraph(){
  const container = document.getElementById("graphContainer");
  const W = 1000, H = 540, cx = W/2, cy = H/2;
  const n = notes.length;
  const rx = Math.min(400, 180 + n*8);
  const ry = Math.min(210, 110 + n*4);

  const pos = {};
  notes.forEach((note, i) => {
    const angle = (i / Math.max(n,1)) * Math.PI * 2 - Math.PI/2;
    pos[note.id] = { x: cx + rx*Math.cos(angle), y: cy + ry*Math.sin(angle), note };
  });

  const relCount = {};
  REL.forEach(([a,b]) => {
    if(pos[a] && pos[b]){
      relCount[a] = (relCount[a]||0)+1;
      relCount[b] = (relCount[b]||0)+1;
    }
  });

  let defs = '<defs>'+
    '<radialGradient id="coreGrad" cx="50%" cy="50%" r="50%">'+
      '<stop offset="0%" stop-color="'+CONFIG.themeColor+'" stop-opacity="1"/>'+
      '<stop offset="60%" stop-color="'+CONFIG.themeColor+'" stop-opacity="0.5"/>'+
      '<stop offset="100%" stop-color="#8b5cf6" stop-opacity="0"/>'+
    '</radialGradient>'+
    '<linearGradient id="edgeGrad" x1="0%" y1="0%" x2="100%" y2="0%">'+
      '<stop offset="0%" stop-color="#8b5cf6"/>'+
      '<stop offset="100%" stop-color="'+CONFIG.themeColor+'"/>'+
    '</linearGradient>'+
    '<filter id="glow" x="-60%" y="-60%" width="220%" height="220%">'+
      '<feGaussianBlur stdDeviation="4" result="b"/>'+
      '<feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>'+
    '</filter>'+
  '</defs>';

  let edgesHtml = "";
  const curves = [];
  REL.forEach(([a,b], idx) => {
    const pa = pos[a], pb = pos[b];
    if(!pa || !pb) return;
    const mx = (pa.x+pb.x)/2, my = (pa.y+pb.y)/2;
    const ctrlX = mx + (cx - mx)*0.35;
    const ctrlY = my + (cy - my)*0.35;
    const pathId = "edge_"+idx;
    curves.push({ id: pathId, A: pa, B: pb, C: {x:ctrlX,y:ctrlY} });
    edgesHtml += `<path id="${pathId}" d="M ${pa.x} ${pa.y} Q ${ctrlX} ${ctrlY} ${pb.x} ${pb.y}" `+
      `fill="none" stroke="url(#edgeGrad)" stroke-width="1.2" opacity="0.45" `+
      `stroke-dasharray="6 6" class="flowline"/>`;
  });

  let raysHtml = "";
  notes.forEach(note => {
    const p = pos[note.id];
    const color = (AREA[note.area]||AREA.meta).color;
    raysHtml += `<line x1="${cx}" y1="${cy}" x2="${p.x}" y2="${p.y}" stroke="${color}" stroke-width="0.6" opacity="0.18"/>`;
  });

  let nodesHtml = "";
  notes.forEach(note => {
    const p = pos[note.id];
    const color = (AREA[note.area]||AREA.meta).color;
    const conns = relCount[note.id] || 1;
    const r = 14 + Math.min(conns, 8)*1.8;
    nodesHtml += `<g class="graphNode" data-id="${note.id}" style="cursor:pointer;">`+
      `<circle cx="${p.x}" cy="${p.y}" r="${r+6}" fill="none" stroke="${color}" stroke-width="1" opacity="0.35" class="breathe"/>`+
      `<circle cx="${p.x}" cy="${p.y}" r="${r}" fill="${color}" opacity="0.9" filter="url(#glow)"/>`+
      `<text x="${p.x}" y="${p.y + r + 16}" text-anchor="middle" font-size="11" fill="#dfe8f5" font-family="inherit">${escapeXml(note.title)}</text>`+
      `</g>`;
  });

  const coreHtml = `<circle cx="${cx}" cy="${cy}" r="34" fill="url(#coreGrad)" class="core-pulse"/>`+
    `<text x="${cx}" y="${cy+7}" text-anchor="middle" font-size="24">🧠</text>`;

  const style = `<style>
    @keyframes dashmove{ to{ stroke-dashoffset:-120; } }
    .flowline{ animation: dashmove 4s linear infinite; }
    @keyframes breathe{ 0%,100%{ opacity:0.2; transform-origin:center; transform:scale(0.95);} 50%{ opacity:0.55; transform:scale(1.08);} }
    .breathe{ animation: breathe 2.6s ease-in-out infinite; }
    @keyframes corepulse{ 0%,100%{ opacity:0.8; } 50%{ opacity:1; } }
    .core-pulse{ animation: corepulse 2.2s ease-in-out infinite; }
    .node-blink circle{ animation: blinkNode 0.5s ease-in-out 4; }
    @keyframes blinkNode{ 0%,100%{ filter:brightness(1);} 50%{ filter:brightness(2.4);} }
  </style>`;

  const svgStr = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">${style}${defs}${raysHtml}${edgesHtml}${nodesHtml}${coreHtml}<g id="synapseLayer"></g></svg>`;
  container.innerHTML = svgStr;

  container.querySelectorAll(".graphNode").forEach(g => {
    g.addEventListener("click", () => openEditor(g.getAttribute("data-id")));
  });

  updateBrainCount();
  renderLegend();
  setupSynapses(curves, container.querySelector("#synapseLayer"));
}

function escapeXml(s){
  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

function setupSynapses(curves, layer){
  if(rafId) cancelAnimationFrame(rafId);
  if(!curves.length || !layer) return;
  synapses = [];
  const total = Math.min(12, curves.length*2);
  for(let i=0;i<total;i++){
    synapses.push(spawnSynapse(curves));
  }
  function spawnSynapse(curveList){
    const curve = curveList[Math.floor(Math.random()*curveList.length)];
    return { curve, t: Math.random(), speed: 0.004 + Math.random()*0.006 };
  }
  function frame(){
    let html = "";
    synapses.forEach((s, i) => {
      s.t += s.speed;
      if(s.t > 1){ s.t = 0; s.curve = curves[Math.floor(Math.random()*curves.length)]; }
      const t = s.t;
      const A = s.curve.A, B = s.curve.B, C = s.curve.C;
      const x = (1-t)*(1-t)*A.x + 2*(1-t)*t*C.x + t*t*B.x;
      const y = (1-t)*(1-t)*A.y + 2*(1-t)*t*C.y + t*t*B.y;
      const op = Math.sin(t*Math.PI);
      html += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="2.4" fill="#ffffff" opacity="${op.toFixed(2)}"/>`;
    });
    if(layer.isConnected){ layer.innerHTML = html; }
    rafId = requestAnimationFrame(frame);
  }
  frame();
}

function blinkNode(id){
  const g = document.querySelector(`.graphNode[data-id="${id}"]`);
  if(g){ g.classList.add("node-blink"); setTimeout(()=>g.classList.remove("node-blink"), 2200); }
}

function updateBrainCount(){
  const areasUsed = new Set(notes.map(n=>n.area));
  document.getElementById("brainCount").textContent = `${notes.length} notas · ${areasUsed.size} áreas`;
}

function renderLegend(){
  const areasUsed = [...new Set(notes.map(n=>n.area))];
  let html = areasUsed.map(a => {
    const info = AREA[a] || AREA.meta;
    return `<span><span class="dot" style="background:${info.color}"></span>${info.label}</span>`;
  }).join("");
  html += `<span class="injected">✓ contexto injetado em todos os comandos do ${CONFIG.name}</span>`;
  document.getElementById("legend").innerHTML = html;
}

document.getElementById("reloadBtn").addEventListener("click", () => { notes = loadNotes(); renderGraph(); });

/* ============ NOTE EDITOR ============ */
let editingId = null;
function openEditor(id){
  editingId = id;
  const overlay = document.getElementById("editorOverlay");
  const areaSelect = document.getElementById("editArea");
  areaSelect.innerHTML = Object.keys(AREA).map(k => `<option value="${k}">${AREA[k].label}</option>`).join("");

  if(id){
    const note = notes.find(n => n.id === id);
    document.getElementById("editorTitle").textContent = "Editar Nota";
    document.getElementById("editTitle").value = note.title;
    areaSelect.value = note.area;
    document.getElementById("editBody").value = note.body;
    document.getElementById("deleteNoteBtn").classList.remove("hidden");
  } else {
    document.getElementById("editorTitle").textContent = "Nova Nota";
    document.getElementById("editTitle").value = "";
    areaSelect.value = "meta";
    document.getElementById("editBody").value = "";
    document.getElementById("deleteNoteBtn").classList.add("hidden");
  }
  overlay.classList.remove("hidden");
}
function closeEditor(){ document.getElementById("editorOverlay").classList.add("hidden"); editingId = null; }

document.getElementById("addNoteBtn").addEventListener("click", () => openEditor(null));
document.getElementById("cancelEditBtn").addEventListener("click", closeEditor);

document.getElementById("saveNoteBtn").addEventListener("click", () => {
  const title = document.getElementById("editTitle").value.trim();
  const area = document.getElementById("editArea").value;
  const body = document.getElementById("editBody").value.trim();
  if(!title || !body){ return; }
  if(editingId){
    const note = notes.find(n => n.id === editingId);
    note.title = title; note.area = area; note.body = body;
  } else {
    notes.push({ id: "note_"+Date.now(), area, title, body });
  }
  saveNotes();
  closeEditor();
  renderGraph();
});

document.getElementById("deleteNoteBtn").addEventListener("click", () => {
  if(!editingId) return;
  notes = notes.filter(n => n.id !== editingId);
  saveNotes();
  closeEditor();
  renderGraph();
});

