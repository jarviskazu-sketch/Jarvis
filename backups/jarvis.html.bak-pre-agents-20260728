/* ============ SPEECH RECOGNITION ============ */
function setupRecognition(){
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){ showError("Reconhecimento de voz não é suportado neste navegador."); return; }
  recognition = new SR();
  recognition.lang = "pt-BR";
  recognition.continuous = true;
  recognition.interimResults = false;

  recognition.onstart = () => { recognitionRunning = true; };
  recognition.onend = () => {
    recognitionRunning = false;
    if(!busy && !micBlocked){ startRecognition(); }
  };
  recognition.onerror = (e) => {
    recognitionRunning = false;
    if(e.error === "not-allowed" || e.error === "service-not-allowed"){
      micBlocked = true;
      document.getElementById("micBtn").classList.remove("mic-active");
      setOrbState("idle");
      showError("Permissão de microfone negada. Libere o acesso ao microfone para usar a voz.");
    }
  };
  recognition.onresult = (event) => {
    const text = event.results[event.results.length - 1][0].transcript.trim();
    handleHeard(text);
  };
}

function startRecognition(forceActivate){
  if(!recognition) return;
  if(busy) return;
  if(micBlocked){
    requestMicAccess(() => startRecognition(forceActivate));
    return;
  }
  if(forceActivate) wakeActive = true;
  try{ recognition.start(); }catch(e){ /* already started, ignore */ }
  setOrbState("listening");
  document.getElementById("micBtn").classList.add("mic-active");
}
function stopRecognitionSoft(){
  document.getElementById("micBtn").classList.remove("mic-active");
}

document.getElementById("micBtn").addEventListener("click", () => {
  if(!busy) startRecognition(true);
});

function normalize(s){
  return s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g,"").trim();
}

function handleHeard(rawText){
  if(busy) return;
  const norm = normalize(rawText);
  const wake = normalize(CONFIG.wakeWord);

  if(!wakeActive){
    if(norm.includes(wake)){
      const restIdx = norm.indexOf(wake) + wake.length;
      const rest = norm.slice(restIdx).trim();
      if(rest.length > 2){
        routeUserText(rest);
      } else {
        wakeActive = true;
        setJarvisLine("Diga, " + CONFIG.address + ".");
        speak("Diga, " + CONFIG.address + ".");
      }
    }
    return;
  } else {
    wakeActive = false;
    routeUserText(rawText);
  }
}

