function heuristicTriage(e){
  const s = normalize((e.subject||"") + " " + (e.from||""));
  if(/noreply|newsletter|unsubscribe|promo|desinscrever|marketing/.test(s)) return { balde:"ruido", resumo:"provável promoção/newsletter (triagem local)" };
  if(/pergunta|prazo|fatura|reuniao|por favor|urgente|confirma|responda/.test(s)) return { balde:"acao", resumo:"pode pedir ação (triagem local)" };
  return { balde:"info", resumo:"triagem local" };
}
async function triageNewEmails(emails){
  const untriaged = emails.filter(e => !emailTriageCache[e.id]);
  if(!untriaged.length) return;
  const apiKey = (document.getElementById("apiKeyInput").value || localStorage.getItem("anthropic_key") || "").trim();
  if(!apiKey){
    untriaged.forEach(e => { emailTriageCache[e.id] = heuristicTriage(e); });
    saveEmailTriageCache();
    return;
  }
  try{
    const compact = untriaged.slice(0,60).map(e => ({ id:e.id, de:e.from, assunto:e.subject, trecho:(e.excerpt||"").slice(0,200) }));
    const res = await fetch("https://api.anthropic.com/v1/messages", {
      method:"POST",
      headers:{ "x-api-key":apiKey, "anthropic-version":"2023-06-01", "anthropic-dangerous-direct-browser-access":"true", "content-type":"application/json" },
      body: JSON.stringify({
        model: CONFIG.model, max_tokens: 1500,
        system: 'Você tria e-mails em 3 baldes: acao (pede resposta, tarefa, decisão ou tem prazo), info (vale saber mas não exige nada) e ruido (promoção, newsletter, notificação automática). Responda APENAS um array JSON, sem texto ao redor, no formato [{"id":"...","balde":"acao|info|ruido","resumo":"uma frase curta em português"}].',
        messages: [{ role:"user", content: JSON.stringify(compact) }]
      })
    });
    if(!res.ok) throw new Error("triage_http_error");
    const data = await res.json();
    const text = (data.content && data.content[0] && data.content[0].text) || "[]";
    const jsonMatch = text.match(/\[[\s\S]*\]/);
    const arr = JSON.parse(jsonMatch ? jsonMatch[0] : "[]");
    arr.forEach(item => { emailTriageCache[item.id] = { balde:item.balde, resumo:item.resumo }; });
    untriaged.forEach(e => { if(!emailTriageCache[e.id]) emailTriageCache[e.id] = heuristicTriage(e); });
  }catch(e){
    untriaged.forEach(e => { emailTriageCache[e.id] = heuristicTriage(e); });
  }
  saveEmailTriageCache();
}
function relativeTime(dateStr){
  const d = new Date(dateStr);
  if(isNaN(d.getTime())) return "";
  const diffMin = Math.round((Date.now()-d.getTime())/60000);
  if(diffMin < 1) return "agora";
  if(diffMin < 60) return `há ${diffMin} min`;
  const diffH = Math.round(diffMin/60);
  if(diffH < 24) return `há ${diffH} h`;
  return `há ${Math.round(diffH/24)} d`;
}
function renderEmailRows_(list){
  if(!list.length) return '<div style="color:var(--muted);font-size:0.8rem;">nada por aqui</div>';
