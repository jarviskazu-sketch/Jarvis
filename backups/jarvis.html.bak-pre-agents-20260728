<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JARVIS</title>
<style>
  :root{
    --theme: #22c3ff;
    --theme-dim: #0a4a66;
    --violet: #8b5cf6;
    --bg: #05070c;
    --bg2: #0a0f1a;
    --panel: #0d1420;
    --text: #dfe8f5;
    --muted: #7c8aa0;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{
    width:100%; height:100%; background:var(--bg); color:var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    overflow-x:hidden;
  }
  body{ min-height:100vh; }
  .hidden{ display:none !important; }
  ::selection{ background:var(--theme); color:#000; }

  /* ---------- BOOT SCREEN ---------- */
  #bootScreen{
    position:fixed; inset:0; z-index:100;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    background: radial-gradient(ellipse at center, #0a1420 0%, #05070c 70%);
    transition: opacity 0.8s ease;
  }
  #bootScreen.fade-out{ opacity:0; pointer-events:none; }
  .boot-title{
    font-family: "Courier New", monospace;
    font-size: clamp(2.2rem, 8vw, 5rem);
    font-weight:700;
    letter-spacing: 0.15em;
    background: linear-gradient(90deg, var(--theme), var(--violet));
    -webkit-background-clip:text; background-clip:text; color:transparent;
    text-align:center;
  }
  .boot-line{
    width:min(70%,420px); height:2px; margin:22px 0;
    background: linear-gradient(90deg, transparent, var(--theme), var(--violet), transparent);
    animation: bootPulse 1.4s ease-in-out infinite;
  }
  @keyframes bootPulse{ 0%,100%{opacity:.35;} 50%{opacity:1;} }
  .boot-sync{
    font-family:"Courier New", monospace; letter-spacing:0.25em; font-size:0.85rem;
    color: var(--theme); animation: blink 1s steps(2,start) infinite;
  }
  @keyframes blink{ 50%{ opacity:0.15; } }
  .boot-ver{
    position:absolute; bottom:28px; font-family:"Courier New", monospace;
    font-size:0.7rem; letter-spacing:0.2em; color:var(--muted);
  }

  /* ---------- ACTIVATION SCREEN ---------- */
  #activationScreen{
    position:fixed; inset:0; z-index:90;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:28px;
    background: radial-gradient(ellipse at center, #0a1420 0%, #05070c 70%);
  }
  .act-title{
    font-family:"Courier New", monospace; font-weight:700; letter-spacing:0.15em;
    font-size: clamp(2rem, 7vw, 4.2rem);
    background: linear-gradient(90deg, var(--theme), var(--violet));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  #activateBtn{
    font-family:"Courier New", monospace; letter-spacing:0.12em; font-size:1rem;
    padding:16px 38px; border-radius: 999px; cursor:pointer;
    background: transparent; color:var(--theme); border:1px solid var(--theme);
    box-shadow: 0 0 24px -4px var(--theme);
    transition: all .25s ease;
  }
  #activateBtn:hover{ background:var(--theme); color:#001018; box-shadow:0 0 40px -2px var(--theme); }
  .act-hint{ color:var(--muted); font-size:0.78rem; letter-spacing:0.2em; }

  /* ---------- APP SHELL ---------- */
  #app{ display:flex; flex-direction:column; min-height:100vh; }
  header.topbar{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding:10px 18px; border-bottom:1px solid #131c2b; background:var(--bg2);
    flex-wrap:wrap;
  }
  header.topbar .brand{ font-family:"Courier New",monospace; letter-spacing:0.15em; color:var(--theme); font-weight:700; }
  #apiKeyInput{
    background:var(--panel); border:1px solid #1c2740; color:var(--text);
    padding:7px 10px; border-radius:8px; font-size:0.78rem; width:min(260px,42vw);
  }
  #apiKeyStatus{ font-size:0.7rem; color:var(--muted); }

  main.orb-area{
    flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:24px 16px; gap:18px; text-align:center;
  }
  #orbWrap{ position:relative; width:220px; height:220px; cursor:pointer; }
  #orbCanvasSvg{ width:100%; height:100%; }
  .orb-status{ font-size:0.78rem; letter-spacing:0.2em; color:var(--theme); text-transform:uppercase; }
  .transcript{ max-width:640px; width:100%; min-height:56px; }
  .transcript .you{ color:var(--muted); font-size:0.92rem; margin-bottom:6px; }
  .transcript .jarvis{ color:var(--text); font-size:1.05rem; font-weight:500; }

  .controls{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; justify-content:center; }
  #textInput{
    background:var(--panel); border:1px solid #1c2740; color:var(--text);
    padding:11px 14px; border-radius:10px; width:min(420px,72vw); font-size:0.92rem;
  }
  .iconBtn{
    background:var(--panel); border:1px solid #1c2740; color:var(--theme);
    width:42px; height:42px; border-radius:50%; cursor:pointer; font-size:1.1rem;
    display:flex; align-items:center; justify-content:center; transition:.2s;
  }
  .iconBtn:hover{ background:var(--theme); color:#001018; }
  .iconBtn.mic-active{ background:var(--theme); color:#001018; box-shadow:0 0 18px var(--theme); }

  /* ---------- SECOND BRAIN ---------- */
  section.brain{ padding:16px 18px 40px; border-top:1px solid #131c2b; background:var(--bg2); }
  .brain-bar{ display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:10px; }
  .brain-bar .lbl{ font-weight:700; letter-spacing:0.08em; }
  .brain-bar .sub{ color:var(--muted); font-size:0.78rem; margin-left:8px; }
  .brain-bar .right{ display:flex; align-items:center; gap:10px; font-size:0.78rem; color:var(--muted); }
  .brain-bar button{
    background:var(--panel); border:1px solid #1c2740; color:var(--theme); cursor:pointer;
    width:30px; height:30px; border-radius:8px; font-size:0.95rem;
  }
  #graphContainer{ width:100%; max-width:1000px; margin:0 auto; }
  #graphContainer svg{ width:100%; height:auto; display:block; }
  .legend{ display:flex; flex-wrap:wrap; gap:14px; align-items:center; justify-content:center; margin-top:8px; font-size:0.75rem; color:var(--muted); }
  .legend .dot{ display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:5px; vertical-align:middle; }
  .legend .injected{ color:#22c55e; margin-left:auto; }

  /* ---------- NOTE EDITOR ---------- */
  #editorOverlay{
    position:fixed; inset:0; background:rgba(2,5,10,0.75); z-index:200;
    display:flex; align-items:center; justify-content:center; padding:16px;
  }
  #editorBox{
    background:var(--panel); border:1px solid #1c2740; border-radius:14px;
    width:min(420px,94vw); padding:20px; display:flex; flex-direction:column; gap:12px;
  }
  #editorBox h3{ font-size:1rem; letter-spacing:0.05em; }
  #editorBox label{ font-size:0.72rem; color:var(--muted); letter-spacing:0.08em; }
  #editorBox input, #editorBox select, #editorBox textarea{
    background:#0a1220; border:1px solid #1c2740; color:var(--text);
    padding:9px 10px; border-radius:8px; font-size:0.88rem; width:100%; font-family:inherit;
  }
  #editorBox textarea{ min-height:90px; resize:vertical; }
  .editor-actions{ display:flex; justify-content:space-between; gap:8px; margin-top:4px; }
  .btn{ padding:9px 16px; border-radius:8px; cursor:pointer; font-size:0.85rem; border:1px solid #1c2740; background:#0a1220; color:var(--text); }
  .btn.primary{ background:var(--theme); border-color:var(--theme); color:#001018; font-weight:700; }
  .btn.danger{ background:transparent; border-color:#7a2030; color:#ff6b6b; }

  #errorBanner{
    position:fixed; top:10px; left:50%; transform:translateX(-50%); z-index:300;
    background:#3a0f14; border:1px solid #7a2030; color:#ffb4b4;
    padding:10px 18px; border-radius:10px; font-size:0.85rem; max-width:90vw; text-align:center;
  }

  @media (max-width:520px){
    #orbWrap{ width:170px; height:170px; }
    header.topbar{ flex-direction:column; align-items:flex-start; }
  }

  /* ---------- HUD BADGES ---------- */
  .actionBadge{
    background:#ff5547; color:#fff; border-radius:999px; padding:2px 9px;
    font-size:0.72rem; font-weight:700; letter-spacing:0.02em;
  }
  #gearBtn{ font-size:1rem; }

  /* ---------- TAB BAR ---------- */
  nav.tabbar{
    display:flex; gap:8px; padding:12px 18px; border-top:1px solid #131c2b;
    background:var(--bg2); flex-wrap:wrap; align-items:center;
  }
  .tabbtn{
    background:var(--panel); border:1px solid #1c2740; color:var(--muted);
    padding:8px 15px; border-radius:999px; cursor:pointer; font-size:0.78rem;
    letter-spacing:0.05em; display:flex; align-items:center; gap:7px; transition:.2s;
    font-family:inherit;
  }
  .tabbtn:hover{ color:var(--text); }
  .tabbtn.active{ color:var(--theme); border-color:var(--theme); box-shadow:0 0 14px -5px var(--theme); }
  .tabbtn .badge{
    background:#ff5547; color:#fff; border-radius:999px; font-size:0.65rem;
    padding:1px 6px; min-width:16px; text-align:center; line-height:1.4;
  }

  /* ---------- MODULE PANELS ---------- */
  .panelWrap{
    padding:18px; border-top:1px solid #131c2b; background:var(--bg2);
    animation: panelIn .35s ease;
  }
  @keyframes panelIn{ from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);} }
  .panelHead{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; flex-wrap:wrap; gap:10px; }
  .panelHead h2{ font-size:0.92rem; letter-spacing:0.09em; }
  .panelHead .sub{ color:var(--muted); font-size:0.76rem; margin-left:8px; }
  .panelHead .actions{ display:flex; gap:8px; align-items:center; }
  .panelHead button{
    background:var(--panel); border:1px solid #1c2740; color:var(--theme); cursor:pointer;
    width:30px; height:30px; border-radius:8px; font-size:0.9rem;
  }
  .offlineNote{
    background:#241a06; border:1px solid #6b4a10; color:#ffcf7a;
    padding:12px 16px; border-radius:10px; font-size:0.82rem; line-height:1.5;
  }
  .offlineNote code{ background:#000; padding:1px 6px; border-radius:5px; }

  /* agenda */
  .agendaCountdown{ color:var(--theme); font-size:0.82rem; margin-bottom:10px; font-weight:600; }
  .dayGroupLabel{ font-size:0.72rem; letter-spacing:0.12em; color:var(--muted); margin:16px 0 8px; text-transform:uppercase; }
  .eventRow{ display:flex; gap:10px; align-items:flex-start; padding:8px 0; border-bottom:1px solid #131c2b; }
  .eventDot{ width:9px; height:9px; border-radius:50%; margin-top:6px; flex-shrink:0; }
  .eventTime{ font-size:0.76rem; color:var(--muted); min-width:78px; }
  .eventBody{ flex:1; }
  .eventTitle{ font-size:0.88rem; }
  .eventLoc{ font-size:0.74rem; color:var(--muted); margin-top:2px; }

  /* emails */
  .emailBucket{ margin-bottom:16px; }
  .emailBucket h3{ font-size:0.78rem; letter-spacing:0.09em; margin-bottom:8px; color:var(--muted); }
  .emailBucket.action h3{ color:var(--theme); }
  .emailRow{ display:flex; gap:10px; align-items:flex-start; padding:9px 10px; border-radius:8px; cursor:pointer; }
  .emailRow:hover{ background:var(--panel); }
  .emailDot{ width:8px; height:8px; border-radius:50%; margin-top:6px; flex-shrink:0; }
  .emailMain{ flex:1; min-width:0; }
  .emailFrom{ font-size:0.84rem; font-weight:600; }
  .emailSummary{ font-size:0.8rem; color:var(--text); }
  .emailExcerpt{ font-size:0.76rem; color:var(--muted); margin-top:4px; display:none; }
  .emailRow.open .emailExcerpt{ display:block; }
  .emailTime{ font-size:0.72rem; color:var(--muted); white-space:nowrap; }
  details.ruidoBox summary{ cursor:pointer; font-size:0.78rem; color:var(--muted); letter-spacing:0.08em; }

  /* news */
  .newsTopic{ margin-bottom:18px; }
  .newsTopic h3{ font-size:0.84rem; margin-bottom:8px; color:var(--theme); letter-spacing:0.04em; }
  .newsItem{ display:block; padding:7px 0; border-bottom:1px solid #131c2b; color:var(--text); text-decoration:none; font-size:0.85rem; }
  .newsItem:hover{ color:var(--theme); }
  .newsSource{ font-size:0.72rem; color:var(--muted); margin-top:2px; }

  /* digest */
  .digestCard{
    background:var(--panel); border:1px solid #1c2740; border-radius:14px;
    padding:20px; font-size:0.96rem; line-height:1.6; white-space:pre-line;
  }
  .digestActions{ display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; }

  /* settings modal */
  #settingsOverlay{
    position:fixed; inset:0; background:rgba(2,5,10,0.75); z-index:250;
    display:flex; align-items:center; justify-content:center; padding:16px;
  }
  #settingsBox{
    background:var(--panel); border:1px solid #1c2740; border-radius:14px;
    width:min(640px,96vw); max-height:88vh; overflow-y:auto;
    padding:22px; display:flex; flex-direction:column; gap:16px;
  }
  #settingsBox h3{ font-size:1.05rem; letter-spacing:0.05em; }
  .settingsSection{ border-top:1px solid #1c2740; padding-top:14px; }
  .settingsSection h4{ font-size:0.82rem; color:var(--theme); letter-spacing:0.08em; margin-bottom:8px; }
  .settingsHelp{ font-size:0.74rem; color:var(--muted); line-height:1.5; margin-bottom:10px; }
  .settingsWarn{ font-size:0.74rem; color:#ffcf7a; line-height:1.5; margin-bottom:10px; }
  .entryRow{
    display:grid; grid-template-columns:1fr 1fr auto auto auto; gap:6px; margin-bottom:8px; align-items:center;
  }
  .entryRow input, .entryRow select{
    background:#0a1220; border:1px solid #1c2740; color:var(--text);
    padding:7px 8px; border-radius:7px; font-size:0.78rem; width:100%; font-family:inherit;
  }
  .entryRow input[type=color]{ padding:2px; height:32px; }
  .entryRow .rmBtn{
    background:transparent; border:1px solid #7a2030; color:#ff6b6b; border-radius:7px;
    cursor:pointer; width:30px; height:30px;
  }
  .addRowBtn{
    background:transparent; border:1px dashed #1c2740; color:var(--theme); cursor:pointer;
    padding:8px 14px; border-radius:8px; font-size:0.78rem; width:100%;
  }
  .modelChoices{ display:flex; gap:8px; flex-wrap:wrap; }
  .modelChoice{
    flex:1; min-width:140px; background:#0a1220; border:1px solid #1c2740; border-radius:10px;
    padding:10px; cursor:pointer; font-size:0.78rem;
  }
  .modelChoice.active{ border-color:var(--theme); box-shadow:0 0 10px -4px var(--theme); color:var(--theme); }
  .toggleRow{ display:flex; align-items:center; justify-content:space-between; font-size:0.82rem; }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
